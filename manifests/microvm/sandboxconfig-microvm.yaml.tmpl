# Cluster-wide SandboxConfig for the micro-VM (kata + cloud-hypervisor) sandbox
# class. Unlike sandboxconfig-gvisor.yaml (applied unconditionally by
# hack/install-ate.sh --deploy-ate-system), this is opt-in: apply via
# hack/install-microvm-deps.sh --install after staging the asset set
# (assemble.sh + stage-to-gcs.sh / stage-to-rustfs.sh). A microvm WorkerPool
# resolves it as its class default (or names it via configRef: microvm), so
# a missing/stale config shows on the pool's status.
#
# The sandbox binaries (cloud-hypervisor, virtiofsd, guest kernel, guest rootfs)
# are FETCHED at runtime from the asset bucket ${ASSET_BUCKET_NAME} under
# kata-assets/ (the rustfs bucket on kind, its own GCS bucket on GKE), through
# the node's object-store plugin - NOT baked into the worker image.
# ${BUCKET_SCHEME} is that store's URL scheme (s3 on kind, gs on GKE): the
# plugin serves only its own backend's scheme. The assets must stay outside any
# snapshot location, which the plugin refuses to serve as assets. ateworker
# boots cloud-hypervisor itself and gives the actor an overlay rootfs (virtio-fs
# RO lower + guest-tmpfs upper), so it fetches virtiofsd too.
#
# The per-arch sha256 values below are the asset sets produced by
# hack/microvm-assets/assemble.sh; atelet selects the block matching the node's
# architecture, and each cluster's bucket holds that arch's binaries at these
# paths (staged by hack/install-microvm-deps.sh --install).

apiVersion: ate.dev/v1
kind: SandboxConfig
metadata:
  name: microvm
  annotations:
    sandboxconfig.ate.dev/is-class-default: "true"
spec:
  sandboxClass: microvm
  defaultVersion: v1
  versions:
  - name: v1
    state: Enabled
    assets:
      arm64:
        cloud-hypervisor:
          url: "${BUCKET_SCHEME}://${ASSET_BUCKET_NAME}/kata-assets/cloud-hypervisor"
          sha256: "f192b510eea1c710cbc439d716bb0573c223fc463dbe3e6523788a2b7ef62850"
        # virtiofsd serves the overlay RO lower (virtio-fs).
        virtiofsd:
          url: "${BUCKET_SCHEME}://${ASSET_BUCKET_NAME}/kata-assets/virtiofsd"
          sha256: "3aa9240045d2261930ef04138fe05cf288f94c867e63e5d0845758bac5e3d458"
        kata-kernel:
          url: "${BUCKET_SCHEME}://${ASSET_BUCKET_NAME}/kata-assets/vmlinux"
          sha256: "4960f6cf781274eaa445fc9f88bb8c5ce951649278bc9caa13afb1e99cfe80e6"
        kata-image:
          url: "${BUCKET_SCHEME}://${ASSET_BUCKET_NAME}/kata-assets/rootfs.img"
          sha256: "7e3bdd500eb92de17c377bd84f8ed57e50d6bb68c7ec08c88f5e1916cd49f30d"
      # amd64 assets are kata 4.1.0 (assemble.sh ARCH=amd64).
      amd64:
        cloud-hypervisor:
          url: "${BUCKET_SCHEME}://${ASSET_BUCKET_NAME}/kata-assets/cloud-hypervisor"
          sha256: "448af3d4e59b22c2987f7df94c213ad40fb53a10d437e42b5ee6c4fce7c29ecc"
        virtiofsd:
          url: "${BUCKET_SCHEME}://${ASSET_BUCKET_NAME}/kata-assets/virtiofsd"
          sha256: "15b2e72a78cc08a9bd8a6943e89fb69c88cb3cbeb63069efceade835342ac7d4"
        # BENCHMARK ONLY (zram-feature): the zram guest, read from a private GCS
        # bucket through the node's object-store plugin and pinned by sha256.
        # vmlinux: kata 4.1.0 (Linux 6.18.35) plus a fragment that builds in
        # CONFIG_ZRAM (lz4 and zstd backends, lz4 default) and turns PSI on by
        # default. rootfs.img: the stock kata 4.1.0 image, with
        # /usr/bin/kata-agent replaced by an init script that sets up
        # /dev/zram0 (lz4, disksize = 100% of guest RAM, pool capped at 50%,
        # swappiness 150, page-cluster 0) and then execs the real agent
        # (/usr/bin/kata-agent.real). Same partition layout and block size as
        # the stock image, as the virtio-pmem DAX boot requires.
        kata-kernel:
          url: "${BUCKET_SCHEME}://${ASSET_BUCKET_NAME}/kata-assets/vmlinux"
          sha256: "1b72320fd8cb9b43aa9859deaabcee6dcd1d21baff8360b5280a38558131b13f"
        kata-image:
          url: "${BUCKET_SCHEME}://${ASSET_BUCKET_NAME}/kata-assets/rootfs.img"
          sha256: "2633dd575a9293e07414b129ee47ade1461428ff8fbfee3e31941dff1f304120"
